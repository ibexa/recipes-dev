{% extends '@ibexadesign/pagelayout.html.twig' %}

{% trans_default_domain 'ibexa_welcome_page' %}

{% block meta %}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('welcome-page-css') }}
{% endblock %}

{% block content %}
    {% set admin_url = url('ibexa.dashboard', { 'siteaccess': 'admin' }) %}
    {% set version = constant('Ibexa\\Contracts\\Core\\Ibexa::VERSION')|split('.')|slice(0, 2)|join('.') %}

    <header class="ibexa-welcome-hero">
        <div class="ibexa-welcome-hero__background">
            <img class="ibexa-welcome-hero__knot" src="{{ asset('build/images/welcome/knot.png') }}" alt="" />
        </div>
        <div class="ibexa-welcome-container ibexa-welcome-hero__container">
            <img
                class="ibexa-welcome-hero__logo"
                src="{{ asset('build/images/welcome/cohesivo-logo.svg') }}"
                alt="{{ 'ibexa_platform_welcome_page.hero.logo'|trans|desc('Cohesivo by Ibexa') }}"
            />
            <div class="ibexa-welcome-hero__content">
                <div class="ibexa-welcome-hero__text">
                    <h1 class="ibexa-welcome-heading ibexa-welcome-hero__title">
                        {{ 'ibexa_platform_welcome_page.hero.title'|trans|desc('Cohesivo is ready') }}
                    </h1>
                    <p class="ibexa-welcome-hero__lead">
                        {{ 'ibexa_platform_welcome_page.hero.lead'|trans|desc('Your installation is complete. Follow the recommended steps below to configure your project and start building.') }}
                    </p>
                </div>
                <div class="ibexa-welcome-hero__actions">
                    <a href="{{ admin_url }}" class="ibexa-welcome-btn ibexa-welcome-btn--primary">
                        {{ 'ibexa_platform_welcome_page.hero.go_to_cohesivo'|trans|desc('Go to Cohesivo') }}
                    </a>
                    <a href="https://doc.ibexa.co" class="ibexa-welcome-btn ibexa-welcome-btn--secondary">
                        {{ 'ibexa_platform_welcome_page.hero.open_documentation'|trans|desc('Open documentation') }}
                    </a>
                </div>
            </div>
            <div class="ibexa-welcome-hero-art" aria-hidden="true">
                <div class="ibexa-welcome-hero-art__blob ibexa-welcome-hero-art__blob--1">
                    <img src="{{ asset('build/images/welcome/ellipse-hero.svg') }}" alt="" />
                </div>
                <div class="ibexa-welcome-hero-art__blob ibexa-welcome-hero-art__blob--2">
                    <img src="{{ asset('build/images/welcome/ellipse-hero.svg') }}" alt="" />
                </div>
                <div class="ibexa-welcome-hero-art__frame">
                    <div class="ibexa-welcome-hero-art__frame-gradient"></div>
                    <div class="ibexa-welcome-hero-art__frame-photos">
                        <img class="ibexa-welcome-hero-art__frame-photo ibexa-welcome-hero-art__frame-photo--back" src="{{ asset('build/images/welcome/hero-photo-back.png') }}" alt="" />
                        <img class="ibexa-welcome-hero-art__frame-photo" src="{{ asset('build/images/welcome/hero-photo.png') }}" alt="" />
                    </div>
                    <div class="ibexa-welcome-hero-art__frame-glow"></div>
                </div>
                <div class="ibexa-welcome-hero-art__chip ibexa-welcome-hero-art__chip--glass ibexa-welcome-hero-art__chip--translate">
                    <div class="ibexa-welcome-hero-art__chip-list">
                        <div class="ibexa-welcome-hero-art__chip-title">{{ 'ibexa_platform_welcome_page.hero.art.translate'|trans|desc('Translate & Localise') }}</div>
                        <div class="ibexa-welcome-hero-art__chip-rows">
                            {% for flag, language in { 'en': 'ibexa_platform_welcome_page.hero.art.language.en'|trans|desc('English'), 'fr': 'ibexa_platform_welcome_page.hero.art.language.fr'|trans|desc('French'), 'de': 'ibexa_platform_welcome_page.hero.art.language.de'|trans|desc('German'), 'es': 'ibexa_platform_welcome_page.hero.art.language.es'|trans|desc('Spanish') } %}
                                <div class="ibexa-welcome-hero-art__chip-row">
                                    <div class="ibexa-welcome-hero-art__chip-row-main">
                                        <img class="ibexa-welcome-hero-art__flag" src="{{ asset('build/images/welcome/flag-' ~ flag ~ '.png') }}" alt="" />
                                        <div class="ibexa-welcome-hero-art__chip-label">{{ language }}</div>
                                    </div>
                                    <div class="ibexa-welcome-hero-art__tick">
                                        <img src="{{ asset('build/images/welcome/tick.svg') }}" alt="" />
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {% for chip, label in { 'a': 'ibexa_platform_welcome_page.hero.art.brand.a'|trans|desc('Brand A'), 'b': 'ibexa_platform_welcome_page.hero.art.brand.b'|trans|desc('Brand B'), 'c': 'ibexa_platform_welcome_page.hero.art.brand.c'|trans|desc('Brand C') } %}
                    <div class="ibexa-welcome-hero-art__chip ibexa-welcome-hero-art__chip--brand ibexa-welcome-hero-art__chip--brand-{{ chip }}">
                        <div class="ibexa-welcome-hero-art__chip-icon-box ibexa-welcome-hero-art__chip-icon-box--dark">
                            <div class="ibexa-welcome-hero-art__chip-icon">
                                <img src="{{ asset('build/images/welcome/icon-brand.svg') }}" alt="" />
                            </div>
                        </div>
                        {{ label }}
                    </div>
                {% endfor %}
                <div class="ibexa-welcome-hero-art__chip ibexa-welcome-hero-art__chip--content">
                    <div class="ibexa-welcome-hero-art__chip-icon-box ibexa-welcome-hero-art__chip-icon-box--light">
                        <div class="ibexa-welcome-hero-art__chip-icon ibexa-welcome-hero-art__chip-icon--content">
                            <img src="{{ asset('build/images/welcome/icon-content.svg') }}" alt="" />
                        </div>
                    </div>
                    {{ 'ibexa_platform_welcome_page.hero.art.content'|trans|desc('All content in one place') }}
                </div>
                <div class="ibexa-welcome-hero-art__chip ibexa-welcome-hero-art__chip--preview">
                    <div class="ibexa-welcome-hero-art__chip-icon-box ibexa-welcome-hero-art__chip-icon-box--light">
                        <div class="ibexa-welcome-hero-art__chip-icon ibexa-welcome-hero-art__chip-icon--preview">
                            <img src="{{ asset('build/images/welcome/icon-preview.svg') }}" alt="" />
                        </div>
                    </div>
                    {{ 'ibexa_platform_welcome_page.hero.art.preview'|trans|desc('Preview and publish instantly') }}
                </div>
                <img class="ibexa-welcome-hero-art__screenshot" src="{{ asset('build/images/welcome/hero-screenshot.png') }}" alt="" />
                <div class="ibexa-welcome-hero-art__chip ibexa-welcome-hero-art__chip--glass ibexa-welcome-hero-art__chip--seo">
                    <div class="ibexa-welcome-hero-art__chip-icon-box ibexa-welcome-hero-art__chip-icon-box--plain">
                        <div class="ibexa-welcome-hero-art__chip-icon">
                            <img class="ibexa-welcome-hero-art__sparkle ibexa-welcome-hero-art__sparkle--1" src="{{ asset('build/images/welcome/sparkle-1.svg') }}" alt="" />
                            <img class="ibexa-welcome-hero-art__sparkle ibexa-welcome-hero-art__sparkle--2" src="{{ asset('build/images/welcome/sparkle-2.svg') }}" alt="" />
                            <img class="ibexa-welcome-hero-art__sparkle ibexa-welcome-hero-art__sparkle--3" src="{{ asset('build/images/welcome/sparkle-3.svg') }}" alt="" />
                        </div>
                    </div>
                    <div class="ibexa-welcome-hero-art__chip-rows">
                        {% for label in ['ibexa_platform_welcome_page.hero.art.seo'|trans|desc('SEO optimised'), 'ibexa_platform_welcome_page.hero.art.geo'|trans|desc('GEO optimised')] %}
                            <div class="ibexa-welcome-hero-art__chip-row">
                                <div class="ibexa-welcome-hero-art__chip-label ibexa-welcome-hero-art__chip-label--fixed">{{ label }}</div>
                                <div class="ibexa-welcome-hero-art__tick">
                                    <img src="{{ asset('build/images/welcome/tick2.svg') }}" alt="" />
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="ibexa-welcome-hero-art__boxes">
                    <div class="ibexa-welcome-hero-art__box ibexa-welcome-hero-art__box--dashed">
                        <img src="{{ asset('build/images/welcome/icon-numpad.svg') }}" alt="" width="12" height="12" />
                    </div>
                    <div class="ibexa-welcome-hero-art__box ibexa-welcome-hero-art__box--filled">
                        <img src="{{ asset('build/images/welcome/icon-image.svg') }}" alt="" width="20" height="20" />
                    </div>
                </div>
                <img class="ibexa-welcome-hero-art__cursor" src="{{ asset('build/images/welcome/icon-cursor.svg') }}" alt="" />
            </div>
        </div>
    </header>

    <main>
        <section class="ibexa-welcome-container ibexa-welcome-resources">
            <div class="ibexa-welcome-resources__header">
                <h2 class="ibexa-welcome-heading ibexa-welcome-resources__title">
                    {{ 'ibexa_platform_welcome_page.resources.title'|trans|desc('Developer resources') }}
                </h2>
                <p class="ibexa-welcome-resources__subtitle">
                    {{ 'ibexa_platform_welcome_page.resources.subtitle'|trans|desc('Recommended resources to build, configure and extend your project.') }}
                </p>
            </div>
            <div class="ibexa-welcome-resources__grid">
                <div class="ibexa-welcome-card ibexa-welcome-card--featured">
                    <div class="ibexa-welcome-card__blob" aria-hidden="true">
                        <img src="{{ asset('build/images/welcome/ellipse-card.svg') }}" alt="" />
                    </div>
                    <div class="ibexa-welcome-card__content">
                        <div class="ibexa-welcome-card__icon-box">
                            <svg class="ibexa-welcome-card__icon" aria-hidden="true"><use href="{{ ibexa_icon_path('file-add') }}"></use></svg>
                        </div>
                        <div class="ibexa-welcome-card__text">
                            <h3 class="ibexa-welcome-heading ibexa-welcome-card__title">
                                {{ 'ibexa_platform_welcome_page.resources.first_steps.title'|trans|desc('First steps') }}
                            </h3>
                            <p class="ibexa-welcome-card__description">
                                {{ 'ibexa_platform_welcome_page.resources.first_steps.description'|trans|desc('Set up your content model, templates and SiteAccesses, then replace this welcome page.') }}
                            </p>
                        </div>
                        <a href="https://doc.ibexa.co/en/latest/getting_started/first_steps/" class="ibexa-welcome-btn ibexa-welcome-btn--light">
                            {{ 'ibexa_platform_welcome_page.resources.first_steps.action'|trans|desc('Explore first steps') }}
                        </a>
                    </div>
                    <img class="ibexa-welcome-card__knot" src="{{ asset('build/images/welcome/knot.png') }}" alt="" aria-hidden="true" />
                </div>
                <div class="ibexa-welcome-card">
                    <div class="ibexa-welcome-card__icon-box">
                        <svg class="ibexa-welcome-card__icon" aria-hidden="true"><use href="{{ ibexa_icon_path('academy') }}"></use></svg>
                    </div>
                    <div class="ibexa-welcome-card__text">
                        <h3 class="ibexa-welcome-heading ibexa-welcome-card__title">
                            {{ 'ibexa_platform_welcome_page.resources.tutorial.title'|trans|desc('Beginner tutorial') }}
                        </h3>
                        <p class="ibexa-welcome-card__description">
                            {{ 'ibexa_platform_welcome_page.resources.tutorial.description'|trans|desc('Build your first site step by step, from content model to frontend templates.') }}
                        </p>
                    </div>
                    <a href="https://doc.ibexa.co/en/latest/tutorials/beginner_tutorial/beginner_tutorial/" class="ibexa-welcome-btn ibexa-welcome-btn--secondary">
                        {{ 'ibexa_platform_welcome_page.resources.tutorial.action'|trans|desc('Start tutorial') }}
                    </a>
                </div>
                <div class="ibexa-welcome-card">
                    <div class="ibexa-welcome-card__icon-box">
                        <svg class="ibexa-welcome-card__icon" aria-hidden="true"><use href="{{ ibexa_icon_path('bell') }}"></use></svg>
                    </div>
                    <div class="ibexa-welcome-card__text">
                        <h3 class="ibexa-welcome-heading ibexa-welcome-card__title">
                            {{ 'ibexa_platform_welcome_page.resources.whats_new.title'|trans({ '%version%': version })|desc('What’s new in %version%') }}
                        </h3>
                        <p class="ibexa-welcome-card__description">
                            {{ 'ibexa_platform_welcome_page.resources.whats_new.description'|trans|desc('See new features, deprecations and breaking changes in this release.') }}
                        </p>
                    </div>
                    <a href="https://doc.ibexa.co/en/latest/release_notes/release_notes/" class="ibexa-welcome-btn ibexa-welcome-btn--secondary">
                        {{ 'ibexa_platform_welcome_page.resources.whats_new.action'|trans|desc('Read release notes') }}
                    </a>
                </div>
                <div class="ibexa-welcome-card">
                    <div class="ibexa-welcome-card__icon-box">
                        <svg class="ibexa-welcome-card__icon" aria-hidden="true"><use href="{{ ibexa_icon_path('file-code') }}"></use></svg>
                    </div>
                    <div class="ibexa-welcome-card__text">
                        <h3 class="ibexa-welcome-heading ibexa-welcome-card__title">
                            {{ 'ibexa_platform_welcome_page.resources.apis.title'|trans|desc('APIs') }}
                        </h3>
                        <p class="ibexa-welcome-card__description">
                            {{ 'ibexa_platform_welcome_page.resources.apis.description'|trans|desc('Build headless experiences and integrations with REST, GraphQL or the PHP API.') }}
                        </p>
                    </div>
                    <a href="https://doc.ibexa.co/en/latest/api/api/" class="ibexa-welcome-btn ibexa-welcome-btn--secondary">
                        {{ 'ibexa_platform_welcome_page.resources.apis.action'|trans|desc('Explore APIs') }}
                    </a>
                </div>
                <div class="ibexa-welcome-card">
                    <div class="ibexa-welcome-card__icon-box">
                        <svg class="ibexa-welcome-card__icon" aria-hidden="true"><use href="{{ ibexa_icon_path('form-check-list') }}"></use></svg>
                    </div>
                    <div class="ibexa-welcome-card__text">
                        <h3 class="ibexa-welcome-heading ibexa-welcome-card__title">
                            {{ 'ibexa_platform_welcome_page.resources.security.title'|trans|desc('Security checklist') }}
                        </h3>
                        <p class="ibexa-welcome-card__description">
                            {{ 'ibexa_platform_welcome_page.resources.security.description'|trans|desc('Review the recommended security measures before you deploy to production.') }}
                        </p>
                    </div>
                    <a href="https://doc.ibexa.co/en/latest/infrastructure_and_maintenance/security/security_checklist/" class="ibexa-welcome-btn ibexa-welcome-btn--secondary">
                        {{ 'ibexa_platform_welcome_page.resources.security.action'|trans|desc('View checklist') }}
                    </a>
                </div>
            </div>
        </section>

        <section class="ibexa-welcome-container ibexa-welcome-infra">
            <div class="ibexa-welcome-infra__banner">
                <img class="ibexa-welcome-infra__blob" src="{{ asset('build/images/welcome/ellipse-infra.svg') }}" alt="" aria-hidden="true" />
                <div class="ibexa-welcome-infra__content">
                    <div class="ibexa-welcome-infra__text">
                        <h2 class="ibexa-welcome-heading ibexa-welcome-infra__title">
                            {{ 'ibexa_platform_welcome_page.infrastructure.title'|trans|desc('Infrastructure and maintenance') }}
                        </h2>
                        <p class="ibexa-welcome-infra__description">
                            {{ 'ibexa_platform_welcome_page.infrastructure.description'|trans|desc('Set up caching, backups, background tasks and monitoring, so your project is ready for production.') }}
                        </p>
                    </div>
                    <a href="https://doc.ibexa.co/en/latest/infrastructure_and_maintenance/infrastructure_and_maintenance/" class="ibexa-welcome-btn ibexa-welcome-btn--secondary">
                        {{ 'ibexa_platform_welcome_page.infrastructure.action'|trans|desc('Explore guide') }}
                    </a>
                </div>
                <div class="ibexa-welcome-infra__cards" aria-hidden="true">
                    {% for index in 1..3 %}
                        <div class="ibexa-welcome-infra__card-shadow ibexa-welcome-infra__card-shadow--{{ index }}"></div>
                        <div class="ibexa-welcome-infra__card ibexa-welcome-infra__card--{{ index }}">
                            <img class="ibexa-welcome-infra__card-logo" src="{{ asset('build/images/welcome/infra-logo-' ~ index ~ '.svg') }}" alt="" />
                            <div class="ibexa-welcome-infra__card-line"></div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>

    <footer class="ibexa-welcome-help">
        <div class="ibexa-welcome-help__band">
            <div class="ibexa-welcome-container">
                <div class="ibexa-welcome-help__content">
                    <div class="ibexa-welcome-help__text">
                        <h2 class="ibexa-welcome-heading ibexa-welcome-help__title">
                            {{ 'ibexa_platform_welcome_page.help.title'|trans|desc('Need help?') }}
                        </h2>
                        <p class="ibexa-welcome-help__description">
                            {{ 'ibexa_platform_welcome_page.help.description'|trans|desc('Check common installation issues or contact our Support team.') }}
                        </p>
                    </div>
                    <div class="ibexa-welcome-help__actions">
                        <a href="https://doc.ibexa.co/en/latest/getting_started/troubleshooting/" class="ibexa-welcome-btn ibexa-welcome-btn--light">
                            {{ 'ibexa_platform_welcome_page.help.troubleshooting'|trans|desc('Troubleshooting') }}
                        </a>
                        <a href="https://support.ibexa.co" class="ibexa-welcome-btn ibexa-welcome-btn--text">
                            {{ 'ibexa_platform_welcome_page.help.support'|trans|desc('Go to support') }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="ibexa-welcome-help__copyright">
            <div class="ibexa-welcome-container ibexa-welcome-help__copyright-inner">
                <div class="ibexa-welcome-help__line"></div>
                {{ 'ibexa_platform_welcome_page.copyright'|trans({ '%current_year%': 'now'|date('Y') })|desc('Copyright © %current_year% Ibexa | Powered by Cohesivo CMS') }}
            </div>
        </div>
        <div class="ibexa-welcome-help__decor" aria-hidden="true">
            <img class="ibexa-welcome-help__blob" src="{{ asset('build/images/welcome/ellipse-footer.svg') }}" alt="" />
            <div class="ibexa-welcome-help__texture">
                <img src="{{ asset('build/images/welcome/help-texture.png') }}" alt="" />
            </div>
            <div class="ibexa-welcome-help__photos">
                <img class="ibexa-welcome-help__photo ibexa-welcome-help__photo--shadow" src="{{ asset('build/images/welcome/help-photo-shadow.png') }}" alt="" />
                <img class="ibexa-welcome-help__photo" src="{{ asset('build/images/welcome/help-photo.png') }}" alt="" />
                <div class="ibexa-welcome-help__photo-blur">
                    <img src="{{ asset('build/images/welcome/help-photo.png') }}" alt="" />
                </div>
                {% for index in 1..2 %}
                    <div class="ibexa-welcome-help__bubble ibexa-welcome-help__bubble--{{ index }}">
                        <div class="ibexa-welcome-help__bubble-lines">
                            <div class="ibexa-welcome-help__bubble-line ibexa-welcome-help__bubble-line--1"></div>
                            <div class="ibexa-welcome-help__bubble-line ibexa-welcome-help__bubble-line--2"></div>
                            <div class="ibexa-welcome-help__bubble-line ibexa-welcome-help__bubble-line--3"></div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </footer>
{% endblock %}
