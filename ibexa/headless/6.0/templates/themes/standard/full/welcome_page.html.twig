{% extends '@ibexadesign/pagelayout.html.twig' %}

{% trans_default_domain 'ibexa_welcome_page' %}

{% block meta %}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('welcome-page-css') }}
{% endblock %}

{% block content %}
    <header class="ibexa-welcome-hero">
        <img class="ibexa-welcome-hero__art" src="{{ asset('build/images/welcome/hero-art.webp') }}" alt="" width="3200" height="960" />
        <div class="ibexa-welcome-container">
            <img
                class="ibexa-welcome-hero__logo"
                src="{{ asset('build/images/welcome/cohesivo-logo.svg') }}"
                alt="{{ 'ibexa_platform_welcome_page.hero.logo'|trans|desc('Cohesivo by Ibexa') }}"
            />
            <div class="ibexa-welcome-hero__content">
                <div class="ibexa-welcome-hero__text">
                    <h1 class="ibexa-welcome-hero__title">
                        {{ 'ibexa_platform_welcome_page.hero.title'|trans|desc('Cohesivo is ready') }}
                    </h1>
                    <p class="ibexa-welcome-hero__lead">
                        {{ 'ibexa_platform_welcome_page.hero.lead'|trans|desc('Your installation is complete. Follow the recommended steps below to configure your project and start building.') }}
                    </p>
                </div>
                <div class="ibexa-welcome-hero__actions">
                    <a href="{{ url('ibexa.dashboard', { 'siteaccess': 'admin' }) }}" class="ibexa-welcome-btn ibexa-welcome-btn--primary">
                        {{ 'ibexa_platform_welcome_page.hero.go_to_cohesivo'|trans|desc('Go to Cohesivo') }}
                    </a>
                    <a href="https://doc.ibexa.co" class="ibexa-welcome-btn ibexa-welcome-btn--secondary">
                        {{ 'ibexa_platform_welcome_page.hero.open_documentation'|trans|desc('Open documentation') }}
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main>
        <section class="ibexa-welcome-container ibexa-welcome-resources">
            <div class="ibexa-welcome-resources__header">
                <h2 class="ibexa-welcome-resources__title">
                    {{ 'ibexa_platform_welcome_page.resources.title'|trans|desc('Developer resources') }}
                </h2>
                <p class="ibexa-welcome-resources__subtitle">
                    {{ 'ibexa_platform_welcome_page.resources.subtitle'|trans|desc('Recommended resources to build, configure and extend your project.') }}
                </p>
            </div>
            <div class="ibexa-welcome-resources__grid">
                {% set cards = [
                    {
                        featured: true,
                        icon: 'file-add',
                        title: 'ibexa_platform_welcome_page.resources.first_steps.title'|trans|desc('First steps'),
                        description: 'ibexa_platform_welcome_page.resources.first_steps.description'|trans|desc('Set up your content model, templates and SiteAccesses, then replace this welcome page.'),
                        action: 'ibexa_platform_welcome_page.resources.first_steps.action'|trans|desc('Explore first steps'),
                        url: 'https://doc.ibexa.co/en/latest/getting_started/first_steps/',
                    },
                    {
                        icon: 'academy',
                        title: 'ibexa_platform_welcome_page.resources.tutorial.title'|trans|desc('Beginner tutorial'),
                        description: 'ibexa_platform_welcome_page.resources.tutorial.description'|trans|desc('Build your first site step by step, from content model to frontend templates.'),
                        action: 'ibexa_platform_welcome_page.resources.tutorial.action'|trans|desc('Start tutorial'),
                        url: 'https://doc.ibexa.co/en/latest/tutorials/beginner_tutorial/beginner_tutorial/',
                    },
                    {
                        icon: 'bell',
                        title: 'ibexa_platform_welcome_page.resources.whats_new.title'|trans({ '%version%': constant('Ibexa\\Contracts\\Core\\Ibexa::VERSION')|split('.')|slice(0, 2)|join('.') })|desc('What’s new in %version%'),
                        description: 'ibexa_platform_welcome_page.resources.whats_new.description'|trans|desc('See new features, deprecations and breaking changes in this release.'),
                        action: 'ibexa_platform_welcome_page.resources.whats_new.action'|trans|desc('Read release notes'),
                        url: 'https://doc.ibexa.co/en/latest/release_notes/release_notes/',
                    },
                    {
                        icon: 'file-code',
                        title: 'ibexa_platform_welcome_page.resources.apis.title'|trans|desc('APIs'),
                        description: 'ibexa_platform_welcome_page.resources.apis.description'|trans|desc('Build headless experiences and integrations with REST, GraphQL or the PHP API.'),
                        action: 'ibexa_platform_welcome_page.resources.apis.action'|trans|desc('Explore APIs'),
                        url: 'https://doc.ibexa.co/en/latest/api/api/',
                    },
                    {
                        icon: 'form-check-list',
                        title: 'ibexa_platform_welcome_page.resources.security.title'|trans|desc('Security checklist'),
                        description: 'ibexa_platform_welcome_page.resources.security.description'|trans|desc('Review the recommended security measures before you deploy to production.'),
                        action: 'ibexa_platform_welcome_page.resources.security.action'|trans|desc('View checklist'),
                        url: 'https://doc.ibexa.co/en/latest/infrastructure_and_maintenance/security/security_checklist/',
                    },
                ] %}
                {% for card in cards %}
                    <div class="ibexa-welcome-card{{ card.featured|default(false) ? ' ibexa-welcome-card--featured' : '' }}">
                        <div class="ibexa-welcome-card__icon-box">
                            <svg class="ibexa-welcome-card__icon" aria-hidden="true"><use href="{{ ibexa_icon_path(card.icon) }}"></use></svg>
                        </div>
                        <div class="ibexa-welcome-card__text">
                            <h3 class="ibexa-welcome-card__title">{{ card.title }}</h3>
                            <p class="ibexa-welcome-card__description">{{ card.description }}</p>
                        </div>
                        <a href="{{ card.url }}" class="ibexa-welcome-btn ibexa-welcome-btn--{{ card.featured|default(false) ? 'light' : 'secondary' }}">{{ card.action }}</a>
                    </div>
                {% endfor %}
            </div>
        </section>

        <section class="ibexa-welcome-container ibexa-welcome-infra">
            <div class="ibexa-welcome-infra__banner">
                <div class="ibexa-welcome-infra__content">
                    <div class="ibexa-welcome-infra__text">
                        <h2 class="ibexa-welcome-infra__title">
                            {{ 'ibexa_platform_welcome_page.infrastructure.title'|trans|desc('Infrastructure and maintenance') }}
                        </h2>
                        <p class="ibexa-welcome-infra__description">
                            {{ 'ibexa_platform_welcome_page.infrastructure.description'|trans|desc('Set up caching, backups, background tasks and monitoring, so your project is ready for production.') }}
                        </p>
                    </div>
                    <a href="https://doc.ibexa.co/en/latest/infrastructure_and_maintenance/infrastructure_and_maintenance/" class="ibexa-welcome-btn ibexa-welcome-btn--secondary">
                        {{ 'ibexa_platform_welcome_page.infrastructure.action'|trans|desc('Explore guide') }}
                    </a>
                </div>
            </div>
        </section>
    </main>

    <footer class="ibexa-welcome-help">
        <img class="ibexa-welcome-help__art" src="{{ asset('build/images/welcome/help-art.webp') }}" alt="" width="2560" height="333" />
        <div class="ibexa-welcome-help__band">
            <div class="ibexa-welcome-container">
                <div class="ibexa-welcome-help__content">
                    <div class="ibexa-welcome-help__text">
                        <h2 class="ibexa-welcome-help__title">
                            {{ 'ibexa_platform_welcome_page.help.title'|trans|desc('Need help?') }}
                        </h2>
                        <p class="ibexa-welcome-help__description">
                            {{ 'ibexa_platform_welcome_page.help.description'|trans|desc('Check common installation issues or contact our Support team.') }}
                        </p>
                    </div>
                    <div class="ibexa-welcome-help__actions">
                        <a href="https://doc.ibexa.co/en/latest/getting_started/troubleshooting/" class="ibexa-welcome-btn ibexa-welcome-btn--light">
                            {{ 'ibexa_platform_welcome_page.help.troubleshooting'|trans|desc('Troubleshooting') }}
                        </a>
                        <a href="https://support.ibexa.co" class="ibexa-welcome-btn ibexa-welcome-btn--text">
                            {{ 'ibexa_platform_welcome_page.help.support'|trans|desc('Go to support') }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="ibexa-welcome-help__copyright">
            <div class="ibexa-welcome-container ibexa-welcome-help__copyright-inner">
                {{ 'ibexa_platform_welcome_page.copyright'|trans({ '%current_year%': 'now'|date('Y') })|desc('Copyright © %current_year% Ibexa | Powered by Cohesivo CMS') }}
            </div>
        </div>
    </footer>
{% endblock %}
