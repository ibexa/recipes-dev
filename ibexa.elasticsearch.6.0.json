                        "",
                        "ibexa_elasticsearch:",
                        "    connections:",
                        "        default:",
                        "            hosts:",
                        "                - \"%elasticsearch_dsn%\"",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "ff8a631681cdf31e22394fb0b97fbb8fc17cd796"
