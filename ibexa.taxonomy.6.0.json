{
    "manifests": {
        "ibexa/taxonomy": {
            "manifest": {
                "bundles": {
                    "Ibexa\\Bundle\\Taxonomy\\IbexaTaxonomyBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                }
            },
            "files": {
                "config/packages/ibexa_taxonomy.yaml": {
                    "contents": [
                        "ibexa_taxonomy:",
